# ======================
# AWS CONFIGURATION
# ======================
AWS_REGION=us-east-1
STAGE=dev

# ======================
# COGNITO CONFIGURATION
# ======================
COGNITO_USER_POOL_ID=us-east-1_0YoWedrD0
COGNITO_USER_POOL_CLIENT_ID=234rg4vkoqmj3j3b9mgglv8h97
COGNITO_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_lQg3cGlmw
COGNITO_DOMAIN=auth.security-incident.app

# ======================
# API GATEWAY CONFIG
# ======================
API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com/dev
API_VERSION=v1
CORS_ORIGINS=*

# ======================
# AUTHENTICATION
# ======================
JWT_EXPIRATION=1d
TOKEN_ISSUER=security-incident-app
REFRESH_TOKEN_EXPIRATION=30d
ACCESS_TOKEN_EXPIRATION=1h

# ======================
# DATABASE TABLES
# ======================
USERS_TABLE_NAME=dev-users
INCIDENTS_TABLE_NAME=security-incident-reporting-dev-incidents
ORGANIZATIONS_TABLE_NAME=dev-organizations

# (Legacy keys for backward compatibility, can be removed if not used)
DYNAMO_INCIDENTS_TABLE=security-incident-reporting-dev-incidents
DYNAMO_USERS_TABLE=dev-users
DYNAMO_ORGANIZATIONS_TABLE=dev-organizations

# ======================
# S3 BUCKETS
# ======================
S3_INCIDENT_MEDIA_BUCKET=dev-incident-media
S3_ML_MODELS_BUCKET=dev-ml-models

# ======================
# SERVICE ENDPOINTS
# ======================
## Auth Endpoints
API_REGISTER=/auth/register
API_LOGIN=/auth/login
API_REFRESH_TOKEN=/auth/refresh
API_CONFIRM_REGISTER=/auth/confirm

## User Endpoints 
API_GET_USER=/users/{userId}
API_UPDATE_USER=/users/{userId}
API_CREATE_SECURITY_PERSONNEL=/users/security

## Incident Endpoints
API_CREATE_INCIDENT=/incidents
API_GET_INCIDENT=/incidents/{incidentId}
API_UPLOAD_INCIDENT_MEDIA=/incidents/{incidentId}/media
API_LIST_USER_INCIDENTS=/users/{userId}/incidents
API_LIST_ALL_INCIDENTS=/incidents
API_UPDATE_INCIDENT_STATUS=/incidents/{incidentId}/status

## Notification Endpoints
API_CREATE_NOTIFICATION_CONFIG=/notifications/config
API_SUBSCRIBE_TO_NOTIFICATIONS=/notifications/subscribe

# ======================
# MACHINE LEARNING
# ======================
FRAUD_DETECTION_THRESHOLD=0.7
SEVERITY_OVERRIDE_THRESHOLD=0.8
CREDIBILITY_MINIMUM=0.5
SAGEMAKER_FRAUD_ENDPOINT=fraud-detection-2023
SAGEMAKER_CLASSIFICATION_ENDPOINT=incident-classifier

# ======================
# NOTIFICATIONS
# ======================
NOTIFICATION_RETRY_ATTEMPTS=3
MESSAGE_TTL_SECONDS=3600
SNS_HIGH_PRIORITY_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:high-priority-incidents

# ======================
# FEATURE FLAGS
# ======================
FEATURE_FRAUD_DETECTION=true
FEATURE_ML_CLASSIFICATION=true
FEATURE_HIGH_PRIORITY_ALERTS=true
FEATURE_IMAGE_ANALYSIS=false

# ======================
# LOGGING & MONITORING
# ======================
LOG_LEVEL=debug
LOG_RETENTION_DAYS=7
MONITORING_SAMPLE_RATE=0.1