# Copy this file to .env in the Backend directory for local development.
# Never commit .env or put AWS access keys/secrets in this file.
AWS_REGION=us-east-1
STAGE=dev

# Get these from the Cognito User Pool and its app client in the AWS account
# and region you intend to use. Do not use CloudFormation expressions here.
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_USER_POOL_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
COGNITO_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE_ME

# This must match the users table configured by Backend/src/serverless.yml.
USERS_TABLE_NAME=dev-users
USERS_TABLE=dev-users

# Optional service configuration
GEOCODING_API_KEY=
DEFAULT_SENDER_EMAIL=no-reply@example.com
