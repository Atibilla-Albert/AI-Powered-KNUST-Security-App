# Physical iPhone using Expo Go: use your computer's LAN IPv4 address.
# Keep the iPhone and computer on the same Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:3000/dev

# Android Emulator alternative:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/dev

# iOS Simulator alternative:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/dev
